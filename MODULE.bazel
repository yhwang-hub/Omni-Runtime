new_local_repository = use_repo_rule(
    "@bazel_tools//tools/build_defs/repo:local.bzl",
    "new_local_repository",
)
new_local_repository(
    name = "qwen_fp8_blas",
    path = "/home/wangyh/workspace/envs/qwen3.8-fp8/lib/python3.12/site-packages/nvidia/cu13/lib",
    build_file_content = """
package(default_visibility = ["//visibility:public"])
cc_import(
    name = "cublas_lt",
    shared_library = "libcublasLt.so.13",
)
cc_import(
    name = "cublas",
    shared_library = "libcublas.so.13",
    deps = [":cublas_lt"],
)
""",
)
