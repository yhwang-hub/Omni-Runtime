package(default_visibility = ["//visibility:public"])

cc_library(
    name = "backend",
    srcs = [
        "backend.cc",
        "backend_cuda.cc",
        "backend_opencl.cc",
    ],
    hdrs = [
        "backend.h",
        "backend_compute_define.h",
        "backend_cuda.h",
        "backend_define.h",
        "backend_opencl.h",
    ],
    copts = ["-std=c++20"],
    deps = [
        "//Omni-Runtime/kernels:kernels",
        "//Omni-Runtime/utils:utils",
        "@local_cuda//:cublas",
        "@local_cuda//:cuda_runtime",
    ],
    linkopts = ["-lOpenCL"],
)

cc_test(
    name = "backend_test",
    srcs = ["backend_test.cc"],
    copts = ["-std=c++20"],
    deps = [
        ":backend",
        "@googletest//:gtest_main",
    ],
)

cc_library(
    name = "jit_backend",
    srcs = glob(["cuda_jit/*.cc", "opencl_jit/*.cc"], exclude = [
        "cuda_jit/jit_runtime.cc",
        "opencl_jit/*_test.cc",
    ]),
    hdrs = glob(["cuda_jit/*.h", "opencl_jit/*.h"], exclude = ["cuda_jit/jit_runtime.h"]),
    includes = [".."],
    copts = ["-std=c++20"],
    deps = [
        "//Omni-Runtime/kernel:compiler_core",
        "@local_cuda//:cuda",
        "@local_cuda//:cuda_runtime",
    ],
    linkopts = ["-ldl", "-lOpenCL", "-lpthread"],
)

cc_library(
    name = "jit_runtime",
    srcs = ["cuda_jit/jit_runtime.cc"],
    hdrs = ["cuda_jit/jit_runtime.h"],
    copts = ["-std=c++20"],
    deps = [
        ":jit_backend",
        "//Omni-Runtime/kernel:compiler_core",
        "@local_cuda//:cuda_runtime",
    ],
)

cc_test(
    name = "opencl_jit_test",
    srcs = ["opencl_jit/opencl_jit_test.cc"],
    copts = ["-std=c++20"],
    deps = [
        ":jit_backend",
        "@googletest//:gtest_main",
    ],
)
