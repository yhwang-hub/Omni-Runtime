package(default_visibility = ["//visibility:public"])

cc_library(
    name = "device_define",
    hdrs = ["backend_define.h"],
    copts = ["-std=c++20"],
    deps = ["//Omni-Runtime/utils:utils"],
)

cc_library(
    name = "compute_define",
    hdrs = ["backend_compute_define.h", "opencl_jit/executor.h"],
    copts = ["-std=c++20"],
    deps = [
        ":device_define",
    ],
)

cc_library(
    name = "backend",
    srcs = [
        "backend.cc",
        "backend_cuda.cc",
        "backend_opencl.cc",
        "execution_graph.cc",
    ],
    hdrs = [
        "backend.h",
        "backend_cuda.h",
        "backend_opencl.h",
        "runtime_path.h",
    ],
    copts = ["-std=c++20"],
    deps = [
        ":compute_define",
        ":opencl_executor",
        "//Omni-Runtime/kernels:kernels",
        "//Omni-Runtime/utils:utils",
        "@local_cuda//:cublas",
        "@local_cuda//:cuda_runtime",
    ],
    linkopts = ["-lOpenCL"],
)

cc_library(
    name = "opencl_executor",
    srcs = ["opencl_jit/executor.cc"],
    hdrs = ["runtime_path.h"],
    deps = [":compute_define", ":jit_backend", "//Omni-Runtime/utils:utils"],
    copts = ["-std=c++20"],
    linkopts = ["-lOpenCL"],
)

cc_test(
    name = "backend_test",
    srcs = ["backend_test.cc", "execution_graph_test.cc"],
    copts = ["-std=c++20"],
    deps = [
        ":backend",
        "@googletest//:gtest_main",
    ],
)

cc_library(
    name = "jit_backend",
    srcs = glob(["cuda_jit/*.cc", "opencl_jit/*.cc"], exclude = [
        "cuda_jit/jit_runtime.cc",
        "opencl_jit/*_test.cc",
        "opencl_jit/executor.cc",
    ]),
    hdrs = glob(["cuda_jit/*.h", "opencl_jit/*.h"], exclude = [
        "cuda_jit/jit_runtime.h",
        "opencl_jit/executor.h",
    ]),
    includes = [".."],
    copts = ["-std=c++20"],
    deps = [
        ":compute_define",
        "//Omni-Runtime/kernel:compiler_core",
        "@local_cuda//:cuda",
        "@local_cuda//:cuda_runtime",
    ],
    linkopts = ["-ldl", "-lOpenCL", "-lpthread"],
)

cc_library(
    name = "jit_runtime",
    srcs = ["cuda_jit/jit_runtime.cc"],
    hdrs = ["cuda_jit/jit_runtime.h"],
    copts = ["-std=c++20"],
    deps = [
        ":jit_backend",
        "//Omni-Runtime/kernel:compiler_core",
        "@local_cuda//:cuda_runtime",
    ],
)

cc_test(
    name = "opencl_jit_test",
    srcs = ["opencl_jit/opencl_jit_test.cc"],
    copts = ["-std=c++20"],
    deps = [
        ":jit_backend",
        "@googletest//:gtest_main",
    ],
)
