        "//Omni-Runtime/gguf_serializer:gguf_serializer",
        "//Omni-Runtime/inference/common/inference_define:inference_define",
        "//Omni-Runtime/memory:memory",
        "//Omni-Runtime/utils:utils",
    ],
)

cc_library(
    name = "generation",
    srcs = ["generation/autoregressive_runner.cc"],
    hdrs = ["generation/autoregressive_runner.h"],
    copts = ["-std=c++20"],
    deps = [
        ":inference",
        "//Omni-Runtime/inference/common/inference_define:inference_define",
        "//Omni-Runtime/inference/common/text_stream:text_stream",
        "//Omni-Runtime/utils:utils",
    ],
)

