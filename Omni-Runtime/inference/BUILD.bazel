package(default_visibility = ["//visibility:public"])

cc_library(
    name = "inference",
    srcs = [
        "inference_graph/inference_graph.cc",
        "sampling/sampler.cc",
        "tokenizer/byte_pair_tokenizer.cc",
        "tokenizer/chat_template.cc",
        "tokenizer/gguf_tokenizer_loader.cc",
        "tokenizer/tokenizer.cc",
        "tokenizer/tokenizer_factory.cc",
        "tokenizer/unigram_tokenizer.cc",
        "tokenizer/word_piece_tokenizer.cc",
    ],
    hdrs = [
        "inference_graph/inference_graph.h",
        "sampling/sampler.h",
        "tokenizer/byte_pair_tokenizer.h",
        "tokenizer/chat_template.h",
        "tokenizer/gguf_tokenizer_loader.h",
        "tokenizer/tokenizer.h",
        "tokenizer/tokenizer_define.h",
        "tokenizer/tokenizer_factory.h",
        "tokenizer/unigram_tokenizer.h",
        "tokenizer/word_piece_tokenizer.h",
