package(default_visibility = ["//visibility:public"])

cc_library(
    name = "image_preprocessor",
    srcs = ["image_preprocessor.cc", "jpeg_decoder.cc", "jpeg_decoder.h"],
    hdrs = ["image_preprocessor.h", "image_preprocessor_define.h"],
    copts = ["-std=c++20"],
    linkopts = ["-ljpeg"],
    deps = [
        "//Omni-Runtime/utils:utils",
        "//third_party/stb:stb_image",
    ],
)

cc_test(
    name = "image_preprocessor_test",
    srcs = ["image_preprocessor_test.cc"],
    copts = ["-std=c++20"],
    data = ["//test/inference:demo.jpeg"],
    deps = [
        ":image_preprocessor",
        "@googletest//:gtest_main",
    ],
)
