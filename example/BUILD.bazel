package(default_visibility = ["//visibility:public"])

cc_test(
    name = "qwen3.8_27B_fp8_inference_test",
    srcs = ["qwen3.8_27B_fp8_inference_test.cc"],
    copts = ["-std=c++20"],
    deps = [
        "@qwen_fp8_blas//:cublas",
        "//Omni-Runtime/inference:engine",
        "//Omni-Runtime/models/qwen3_5:qwen3_5",
        "@googletest//:gtest_main",
    ],
    data = [
        "//Omni-Runtime/inference/conf:qwen3_8_27B_fp8.conf",
        "//Omni-Runtime/models/qwen3_5:graphs",
        "//Omni-Runtime/kernels:kernel_sources",
        "//model/qwen3_8_fp8:models",
        "//test/inference:demo.jpeg",
        "//test/inference:qwen3_8_27b_fp8.txt",
        "//test/inference:qwen3_8_27b_fp8.tokens",
        "//test/inference:qwen3_8_27b_fp8.prompt.tokens",
    ],
    tags = ["exclusive", "model_inference"],
    timeout = "long",
)

